rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos et vidéos du site : tout le monde peut les voir, seul le propriétaire en envoie depuis l'appli.
    match /media/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "apocadrive7@gmail.com"
        && request.auth.token.email_verified == true
        && (request.resource == null || request.resource.size < 500 * 1024 * 1024);
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
